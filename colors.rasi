/* =========================================================
 * ROFI — PALET (dragon: merah gelap + biru es)
 * Sama dengan Kitty, Hyprland (theme.lua), Waybar, Hyprlock.
 * Format: #RRGGBBAA
 * ========================================================= */

* {
    backdrop:  #12060f59;   /* tint tipis di luar panel (35%). Harus > ignore_alpha
                               di rules/layers.lua (0.2) agar tetap di-blur. */
    bg:        #12060fd1;   /* panel kaca: 82% opak */
    bg-solid:  #12060f;
    bg-input:  #12060f99;
    sel:       #e0122e2e;   /* latar item terpilih (merah 18%) */

    fg:        #c9dbe6;
    fg-muted:  #8f9eaa;
    mauve:     #8a5566;

    red:       #e0122e;
    red-hi:    #ff3b55;

    ice:       #8fc4dc;
    ice-hi:    #b3dcee;
}
