/* =========================================================
 * ROFI — PALET (ice blue night)
 * Sama dengan Kitty, Hyprland (theme.lua), Waybar, Hyprlock, Neovim.
 * Format: #RRGGBBAA
 * ========================================================= */

* {
    backdrop:  #0d143359;   /* tint tipis di luar panel (35%). Harus > ignore_alpha
                               di rules/layers.lua (0.2) agar tetap di-blur. */
    bg:        #141d48d1;   /* panel kaca: 82% opak */
    bg-solid:  #141d48;
    bg-input:  #0d143399;
    sel:       #5d80e42e;   /* latar item terpilih (azure 18%) */

    fg:        #dbe6ff;
    fg-muted:  #9aabe0;

    accent:    #5d80e4;
    accent-hi: #8fa8f2;

    sky:       #a8c4ff;
    sky-hi:    #cfdeff;
}
